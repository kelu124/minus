{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-resume.sh",
            "timeout": 20,
            "statusMessage": "minus: loading resume context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/fwsync-check.sh\"",
            "timeout": 30,
            "statusMessage": "minus: firmware <-> python library sync check"
          }
        ]
      }
    ]
  }
}
